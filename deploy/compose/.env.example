# Image location and version. Images are published by the release workflow.
IMAGE_NAMESPACE=ghcr.io/your-github-owner/tencentdb-agent-memory
IMAGE_TAG=v2.1.0

# Host ports.
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# Internal MemoryCore authentication. Use a long random value outside local testing.
MEMORY_CORE_GATEWAY_API_KEY=replace-with-a-long-random-value

# LLM settings used by MemoryCore and Memory Hub.
MEMORY_LLM_PROTOCOL=openai
MEMORY_LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_API_KEY=replace-with-your-llm-api-key
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_LLM_MAX_TOKENS=32000
MEMORY_LLM_TIMEOUT_MS=300000

# Public URL that agents use to reach the Knowledge Service.
# It must include the /v3 path and be reachable from the relevant clients.
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8424/v3

# Optional metadata labels shown by the Panel.
REMOTE_INSTANCE_ID=default
REMOTE_INSTANCE_NAME=default

